---
import Accordion from './Accordion.astro';
import ContactEmailForm from './ContactEmailForm.astro';
import { FAQS, getWhatsAppUrl } from '../data/site';

const whatsappQuoteUrl = getWhatsAppUrl('Hola Minji, quisiera cotizar un servicio web');
---

<section class="card-section contact-card">
  <h2 class="section-label">Contacto</h2>

  <p class="hero-bio" style="font-size: 0.92rem; line-height: 1.6; margin-bottom: 16px;">
    Cuéntame qué ofrece tu negocio o marca personal y qué objetivo buscas con tu web. Te respondo por WhatsApp con una cotización clara y fecha de entrega:
  </p>

  <div class="contact-action-wrapper">
    <a
      href={whatsappQuoteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="contact-whatsapp-primary-btn"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="whatsapp-btn-icon" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      <span>Cotizar ahora por WhatsApp</span>
    </a>
  </div>
</section>

<section class="card-section faq-section">
  <h2 class="section-label">Preguntas Frecuentes</h2>
  <Accordion items={FAQS} groupId="faq" />
</section>

<ContactEmailForm />

<style>
  .contact-card,
  .faq-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }

  @media (min-width: 640px) {
    .contact-card,
    .faq-section {
      padding: 32px;
      gap: 20px;
    }
  }

  .contact-action-wrapper {
    display: flex;
    margin-top: 4px;
  }

  .contact-whatsapp-primary-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: var(--radius-inner);
    background: rgba(37, 211, 102, 0.14);
    border: 1px solid rgba(37, 211, 102, 0.35);
    color: #25d366;
    font-family: var(--font-heading);
    font-size: 0.96rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .contact-whatsapp-primary-btn:hover {
    background: rgba(37, 211, 102, 0.24);
    border-color: rgba(37, 211, 102, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(37, 211, 102, 0.25);
  }

  .whatsapp-btn-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    display: block;
  }
</style>
