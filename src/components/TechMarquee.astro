---
// TechMarquee.astro - Carrusel dinámico de herramientas que usamos (Minji Labs)
const tools = [
  { name: "Astro 5"},
  { name: "Tailwind CSS"},
  { name: "TypeScript"},
  { name: "React"},
  { name: "Node.js"},
  { name: "Figma"},
  { name: "Vercel"}
];

// Duplicamos el array para el bucle continuo perfecto al -50%
const marqueeList = [...tools, ...tools];
---

<div class="tech-marquee-wrapper" title="Herramientas y tecnologías con las que trabajo en Minji Labs">
  <div class="marquee-track">
    {marqueeList.map((tool) => (
      <div class="marquee-item">
        <span class="marquee-icon">{tool.icon}</span>
        <span class="marquee-name">{tool.name}</span>
        <span class="marquee-separator">•</span>
      </div>
    ))}
  </div>
</div>

<style>
  .tech-marquee-wrapper {
    width: 100%;
    overflow: hidden;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 12px 0;
    position: relative;
    user-select: none;
    cursor: default;
    /* Máscara de degradado a los lados idéntica a Framer Selv */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .tech-marquee-wrapper:hover {
    background: rgba(200, 43, 67, 0.05);
    border-color: var(--c-primary-border);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 18px;
    width: max-content;
    will-change: transform;
    animation: marquee-scroll 28s linear infinite;
  }

  .tech-marquee-wrapper:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--c-text-secondary);
  }

  .marquee-icon {
    font-size: 0.95rem;
  }

  .marquee-name {
    color: var(--c-text-primary);
    font-family: var(--font-body);
  }

  .marquee-separator {
    color: var(--c-text-muted);
    font-size: 0.75rem;
    margin-left: 10px;
    opacity: 0.6;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
