---
// ContactEmailForm.astro - Formulario directo para contacto por correo electrónico
// Validación personalizada completa estilo Minji Obsidian:
// Popover flotante con flecha triangular superior, badge ámbar y texto idéntico al nativo pero integrado al diseño
const emailDestino = "contacto@minjilabs.com";
---

<section class="card-section selv-email-form-card">
  <h2 class="selv-section-label">Escríbeme por Correo</h2>

  <p class="form-intro-desc">
    Si prefieres comunicarte por correo electrónico, déjame tus datos y cuéntame tu idea para responderte a la brevedad:
  </p>

  <form id="contact-direct-form" class="direct-email-form" novalidate>
    <!-- 1. Nombre -->
    <div class="form-group form-group-nombre" id="group-name">
      <label for="contact-name" class="form-label">Nombre</label>
      <div class="input-relative-wrap">
        <input 
          type="text" 
          id="contact-name" 
          name="name" 
          class="form-input" 
          placeholder="Tu nombre o negocio" 
          required 
          autocomplete="name"
        />
        <!-- Popover flotante personalizado idéntico al nativo -->
        <div class="custom-validation-popover" id="popover-name" role="alert" aria-live="assertive">
          <span class="popover-badge">!</span>
          <span class="popover-text">Completa este campo</span>
        </div>
      </div>
    </div>

    <!-- Fila con Correo y Celular -->
    <div class="form-row-two-col">
      <!-- 2. Correo -->
      <div class="form-group form-group-col" id="group-email">
        <label for="contact-email" class="form-label">Correo electrónico</label>
        <div class="input-relative-wrap">
          <input 
            type="email" 
            id="contact-email" 
            name="email" 
            class="form-input" 
            placeholder="tu@correo.com" 
            required 
            autocomplete="email"
          />
          <div class="custom-validation-popover" id="popover-email" role="alert" aria-live="assertive">
            <span class="popover-badge">!</span>
            <span class="popover-text">Completa este campo</span>
          </div>
        </div>
      </div>

      <!-- 3. Celular -->
      <div class="form-group form-group-col" id="group-phone">
        <label for="contact-phone" class="form-label">Número de celular</label>
        <div class="input-relative-wrap">
          <input 
            type="tel" 
            id="contact-phone" 
            name="phone" 
            class="form-input" 
            placeholder="+51 999 999 999" 
            required 
            autocomplete="tel"
          />
          <div class="custom-validation-popover" id="popover-phone" role="alert" aria-live="assertive">
            <span class="popover-badge">!</span>
            <span class="popover-text">Completa este campo</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Idea en mente o descripción de lo que desea -->
    <div class="form-group form-group-mensaje" id="group-message">
      <label for="contact-message" class="form-label">Tu idea en mente o descripción de lo que deseas</label>
      <div class="input-relative-wrap">
        <textarea 
          id="contact-message" 
          name="message" 
          class="form-textarea" 
          rows="4" 
          placeholder="Cuéntame sobre tu proyecto, qué necesitas o qué tipo de web buscas..." 
          required
        ></textarea>
        <div class="custom-validation-popover" id="popover-message" role="alert" aria-live="assertive">
          <span class="popover-badge">!</span>
          <span class="popover-text">Completa este campo</span>
        </div>
      </div>
    </div>

    <!-- Botón de Envío -->
    <div class="form-submit-row">
      <button type="submit" class="form-submit-button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>Enviar por correo electrónico</span>
      </button>
    </div>
  </form>
</section>

<style>
  .selv-email-form-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    overflow: visible !important;
  }

  @media (min-width: 640px) {
    .selv-email-form-card {
      padding: 32px;
      gap: 20px;
    }
  }

  .form-intro-desc {
    font-size: 0.9rem;
    color: var(--c-text-secondary);
    line-height: 1.6;
    margin-top: -6px;
  }

  .direct-email-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 4px;
    position: relative;
  }

  /* Niveles de apilamiento (z-index) para que los popovers nunca queden tapados */
  .form-group-nombre {
    position: relative;
    z-index: 30;
  }

  .form-row-two-col {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  @media (min-width: 520px) {
    .form-row-two-col {
      flex-direction: row;
      gap: 16px;
    }
  }

  .form-group-col {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .form-group-mensaje {
    position: relative;
    z-index: 10;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .form-label {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Contenedor relativo que alberga el input y su popover flotante */
  .input-relative-wrap {
    position: relative;
    width: 100%;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    background: rgba(14, 14, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 12px 16px;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
    line-height: 1.55;
    display: block;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--c-primary);
    background: rgba(20, 20, 26, 0.95);
    box-shadow: 0 0 0 3px rgba(200, 43, 67, 0.15);
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  /* Resaltado del campo con error activo */
  .input-relative-wrap.has-error .form-input,
  .input-relative-wrap.has-error .form-textarea {
    border-color: #ef4444 !important;
    background: rgba(24, 16, 18, 0.85) !important;
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.3) !important;
  }

  /* ==========================================================================
     POPOVER FLOTANTE PERSONALIZADO (Idéntico a la burbuja nativa pero Obsidian Glass)
     position: absolute; top: calc(100% + 8px); left: 10px;
     NO desplaza NINGÚN elemento del formulario
     ========================================================================== */
  .custom-validation-popover {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 10px;
    z-index: 100;
    align-items: center;
    gap: 9px;
    padding: 7px 14px 7px 10px;
    background: #1c1c24;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9px;
    box-shadow: 0 12px 30px -4px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.08);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    animation: popoverFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Flechita triangular superior que apunta directamente hacia el borde inferior del input */
  .custom-validation-popover::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 18px;
    width: 10px;
    height: 10px;
    background: #1c1c24;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    transform: rotate(45deg);
  }

  /* Cuando el contenedor tiene la clase show-popover, se hace visible */
  .input-relative-wrap.show-popover .custom-validation-popover {
    display: inline-flex;
  }

  /* Badge ámbar con el signo de admiración */
  .popover-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: #e65100; /* Naranja/Ámbar de alta visibilidad idéntico a la imagen */
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
  }

  /* Texto del error */
  .popover-text {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.25;
  }

  @keyframes popoverFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .form-submit-row {
    position: relative;
    z-index: 5;
    margin-top: 4px;
  }

  .form-submit-button {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 16px;
    background: var(--c-primary);
    border: 1px solid var(--c-primary-border);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.94rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 24px -4px var(--c-primary-glow);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-submit-button:hover {
    background: var(--c-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px var(--c-primary-glow);
  }
</style>

<script define:vars={{ emailDestino }}>
  function initContactForm() {
    const form = document.getElementById('contact-direct-form');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const fields = [
      {
        input: document.getElementById('contact-name'),
        wrap: document.getElementById('contact-name')?.closest('.input-relative-wrap'),
        popover: document.getElementById('popover-name'),
        validate: (val) => val.trim().length > 0 ? '' : 'Completa este campo'
      },
      {
        input: document.getElementById('contact-email'),
        wrap: document.getElementById('contact-email')?.closest('.input-relative-wrap'),
        popover: document.getElementById('popover-email'),
        validate: (val) => {
          const v = val.trim();
          if (!v) return 'Completa este campo';
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(v)) return 'Ingresa un correo electrónico válido';
          return '';
        }
      },
      {
        input: document.getElementById('contact-phone'),
        wrap: document.getElementById('contact-phone')?.closest('.input-relative-wrap'),
        popover: document.getElementById('popover-phone'),
        validate: (val) => val.trim().length > 0 ? '' : 'Completa este campo'
      },
      {
        input: document.getElementById('contact-message'),
        wrap: document.getElementById('contact-message')?.closest('.input-relative-wrap'),
        popover: document.getElementById('popover-message'),
        validate: (val) => val.trim().length > 0 ? '' : 'Completa este campo'
      }
    ];

    function clearFieldError(field) {
      if (!field.wrap) return;
      field.wrap.classList.remove('has-error', 'show-popover');
    }

    function showFieldError(field, message) {
      if (!field.wrap) return;
      field.wrap.classList.add('has-error', 'show-popover');
      const textEl = field.popover?.querySelector('.popover-text');
      if (textEl && message) {
        textEl.textContent = message;
      }
    }

    // Escuchadores en tiempo real para limpiar el error en cuanto el usuario escribe o interactúa
    fields.forEach(field => {
      if (!field.input) return;

      field.input.addEventListener('input', () => {
        clearFieldError(field);
      });

      field.input.addEventListener('focus', () => {
        // Al interactuar con un campo, ocultar popovers de otros campos
        fields.forEach(f => {
          if (f !== field && f.wrap) {
            f.wrap.classList.remove('show-popover');
          }
        });
      });
    });

    // Envío del formulario
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      let firstInvalidField = null;
      let firstInvalidMsg = '';

      // Evaluar secuencialmente
      for (const field of fields) {
        if (!field.input) continue;
        const msg = field.validate(field.input.value);
        if (msg) {
          if (!firstInvalidField) {
            firstInvalidField = field;
            firstInvalidMsg = msg;
          }
        }
      }

      if (firstInvalidField) {
        // Limpiar popover de todos los campos primero
        fields.forEach(f => {
          if (f.wrap) f.wrap.classList.remove('show-popover');
        });

        // Mostrar el popover ÚNICAMENTE en el primer campo inválido (comportamiento exacto del navegador)
        showFieldError(firstInvalidField, firstInvalidMsg);
        firstInvalidField.input?.focus();
        return;
      }

      // Si todo es válido, limpiar cualquier estado anterior y enviar
      fields.forEach(f => clearFieldError(f));

      const name = (document.getElementById('contact-name')?.value || "").trim();
      const email = (document.getElementById('contact-email')?.value || "").trim();
      const phone = (document.getElementById('contact-phone')?.value || "").trim();
      const message = (document.getElementById('contact-message')?.value || "").trim();

      const subject = `Consulta web de ${name}`;
      const body = 
`Hola Minji,

Te escribo a través de tu sitio web:

• Nombre: ${name}
• Correo electrónico: ${email}
• Número de celular: ${phone}

Mi idea en mente / descripción de lo que deseo:
${message}

Saludos!`;

      const mailtoUrl = `mailto:${emailDestino}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailtoUrl;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>
