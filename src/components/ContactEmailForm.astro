---
import { SITE_CONFIG } from '../data/site';
---

<section class="card-section email-form-card">
  <h2 class="section-label">Escríbeme por Correo</h2>

  <p class="form-intro-desc">
    ¿Prefieres escribir por correo? Déjame los datos de tu proyecto y te respondo con una cotización a medida:
  </p>

  <form id="contact-direct-form" class="direct-email-form" data-email={SITE_CONFIG.email} novalidate>
    <div class="form-group form-group-nombre" id="group-name">
      <label for="contact-name" class="form-label">Nombre</label>
      <div class="input-relative-wrap">
        <input
          type="text"
          id="contact-name"
          name="name"
          class="form-input"
          placeholder="Ej. Camila Paredes o Estudio Norte"
          required
          autocomplete="name"
        />
        <div class="custom-validation-popover" id="popover-name" role="alert" aria-live="assertive">
          <span class="popover-badge" aria-hidden="true">!</span>
          <span class="popover-text">Completa este campo</span>
        </div>
      </div>
    </div>

    <div class="form-row-two-col">
      <div class="form-group form-group-col" id="group-email">
        <label for="contact-email" class="form-label">Correo electrónico</label>
        <div class="input-relative-wrap">
          <input
            type="email"
            id="contact-email"
            name="email"
            class="form-input"
            placeholder="tu@correo.com"
            required
            autocomplete="email"
          />
          <div class="custom-validation-popover" id="popover-email" role="alert" aria-live="assertive">
            <span class="popover-badge" aria-hidden="true">!</span>
            <span class="popover-text">Completa este campo</span>
          </div>
        </div>
      </div>

      <div class="form-group form-group-col" id="group-phone">
        <label for="contact-phone" class="form-label">Número de celular</label>
        <div class="input-relative-wrap">
          <input
            type="tel"
            id="contact-phone"
            name="phone"
            class="form-input"
            placeholder="+51 999 999 999"
            required
            autocomplete="tel"
          />
          <div class="custom-validation-popover" id="popover-phone" role="alert" aria-live="assertive">
            <span class="popover-badge" aria-hidden="true">!</span>
            <span class="popover-text">Completa este campo</span>
          </div>
        </div>
      </div>
    </div>

    <div class="form-group form-group-mensaje" id="group-message">
      <label for="contact-message" class="form-label">Tu idea en mente o descripción de lo que deseas</label>
      <div class="input-relative-wrap">
        <textarea
          id="contact-message"
          name="message"
          class="form-textarea"
          rows="4"
          placeholder="Qué hace tu negocio, si necesitas una landing o sitio multipágina, y para cuándo te gustaría publicarlo..."
          required
        ></textarea>
        <div class="custom-validation-popover" id="popover-message" role="alert" aria-live="assertive">
          <span class="popover-badge" aria-hidden="true">!</span>
          <span class="popover-text">Completa este campo</span>
        </div>
      </div>
    </div>

    <div class="form-submit-row">
      <button type="submit" class="form-submit-button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>Solicitar cotización por correo</span>
      </button>

      <div class="form-copy-fallback">
        <span>¿No abre tu app de correo?</span>
        <button type="button" id="copy-email-btn" class="copy-email-btn" data-email={SITE_CONFIG.email}>
          Copiar {SITE_CONFIG.email}
        </button>
      </div>
    </div>
  </form>
</section>

<style>
  .email-form-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    overflow: visible;
  }

  @media (min-width: 640px) {
    .email-form-card {
      padding: 32px;
      gap: 20px;
    }
  }

  .form-intro-desc {
    font-size: 0.9rem;
    color: var(--c-text-secondary);
    line-height: 1.6;
    margin-top: -6px;
  }

  .direct-email-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 4px;
    position: relative;
  }

  .form-group-nombre {
    position: relative;
    z-index: 30;
  }

  .form-row-two-col {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  @media (min-width: 520px) {
    .form-row-two-col {
      flex-direction: row;
      gap: 16px;
    }
  }

  .form-group-col {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .form-group-mensaje {
    position: relative;
    z-index: 10;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .form-label {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .input-relative-wrap {
    position: relative;
    width: 100%;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    background: rgba(14, 14, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 12px 16px;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
    line-height: 1.55;
    display: block;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--c-primary);
    background: rgba(20, 20, 26, 0.95);
    box-shadow: 0 0 0 3px rgba(200, 43, 67, 0.15);
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: rgba(255, 255, 255, 0.42);
  }

  .input-relative-wrap.has-error .form-input,
  .input-relative-wrap.has-error .form-textarea {
    border-color: #ef4444;
    background: rgba(24, 16, 18, 0.85);
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.3);
  }

  .custom-validation-popover {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 10px;
    z-index: 100;
    align-items: center;
    gap: 9px;
    padding: 7px 14px 7px 10px;
    max-width: calc(100vw - 64px);
    background: #1c1c24;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9px;
    box-shadow: 0 12px 30px -4px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.08);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    animation: popoverFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 480px) {
    .custom-validation-popover {
      white-space: normal;
    }
  }

  .custom-validation-popover::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 18px;
    width: 10px;
    height: 10px;
    background: #1c1c24;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    transform: rotate(45deg);
  }

  .input-relative-wrap.show-popover .custom-validation-popover {
    display: inline-flex;
  }

  .popover-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: #e65100;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
  }

  .popover-text {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.25;
  }

  @keyframes popoverFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .form-submit-row {
    position: relative;
    z-index: 5;
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .form-submit-button {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 16px;
    background: var(--c-primary);
    border: 1px solid var(--c-primary-border);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.94rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 24px -4px var(--c-primary-glow);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-submit-button:hover {
    background: var(--c-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px var(--c-primary-glow);
  }

  .form-copy-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--c-text-muted);
  }

  .copy-email-btn {
    background: transparent;
    border: none;
    padding: 2px 4px;
    color: var(--c-text-secondary);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .copy-email-btn:hover {
    color: #ffffff;
  }
</style>

<script>
  interface FormField {
    input: HTMLInputElement | HTMLTextAreaElement | null;
    wrap: HTMLElement | null;
    popover: HTMLElement | null;
    validate: (val: string) => string;
  }

  function initContactForm() {
    const form = document.getElementById('contact-direct-form') as HTMLFormElement | null;
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const emailDestino = form.dataset.email || 'contacto@minjilabs.com';

    const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
    const phoneInput = document.getElementById('contact-phone') as HTMLInputElement | null;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

    const fields: FormField[] = [
      {
        input: nameInput,
        wrap: nameInput?.closest('.input-relative-wrap') ?? null,
        popover: document.getElementById('popover-name'),
        validate: (val) => (val.trim().length > 0 ? '' : 'Completa este campo'),
      },
      {
        input: emailInput,
        wrap: emailInput?.closest('.input-relative-wrap') ?? null,
        popover: document.getElementById('popover-email'),
        validate: (val) => {
          const v = val.trim();
          if (!v) return 'Completa este campo';
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : 'Ingresa un correo electrónico válido';
        },
      },
      {
        input: phoneInput,
        wrap: phoneInput?.closest('.input-relative-wrap') ?? null,
        popover: document.getElementById('popover-phone'),
        validate: (val) => (val.trim().length > 0 ? '' : 'Completa este campo'),
      },
      {
        input: messageInput,
        wrap: messageInput?.closest('.input-relative-wrap') ?? null,
        popover: document.getElementById('popover-message'),
        validate: (val) => (val.trim().length > 0 ? '' : 'Completa este campo'),
      },
    ];

    function clearFieldError(field: FormField) {
      field.wrap?.classList.remove('has-error', 'show-popover');
    }

    function showFieldError(field: FormField, message: string) {
      if (!field.wrap) return;
      field.wrap.classList.add('has-error', 'show-popover');
      const textEl = field.popover?.querySelector('.popover-text');
      if (textEl && message) textEl.textContent = message;
    }

    fields.forEach((field) => {
      if (!field.input) return;

      field.input.addEventListener('input', () => clearFieldError(field));
      field.input.addEventListener('focus', () => {
        fields.forEach((f) => {
          if (f !== field) f.wrap?.classList.remove('show-popover');
        });
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      let firstInvalidField: FormField | null = null;
      let firstInvalidMsg = '';

      for (const field of fields) {
        if (!field.input) continue;
        const msg = field.validate(field.input.value);
        if (msg && !firstInvalidField) {
          firstInvalidField = field;
          firstInvalidMsg = msg;
        }
      }

      if (firstInvalidField) {
        fields.forEach((f) => f.wrap?.classList.remove('show-popover'));
        showFieldError(firstInvalidField, firstInvalidMsg);
        firstInvalidField.input?.focus();
        return;
      }

      fields.forEach(clearFieldError);

      const name = (nameInput?.value || '').trim();
      const email = (emailInput?.value || '').trim();
      const phone = (phoneInput?.value || '').trim();
      const message = (messageInput?.value || '').trim();

      const subject = `Consulta web de ${name}`;
      const body =
        `Hola Minji,\n\n` +
        `Te escribo a través de tu sitio web:\n\n` +
        `• Nombre: ${name}\n` +
        `• Correo electrónico: ${email}\n` +
        `• Número de celular: ${phone}\n\n` +
        `Mi idea en mente / descripción de lo que deseo:\n` +
        `${message}\n\n` +
        `Saludos!`;

      window.location.href = `mailto:${emailDestino}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });

    const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
    if (copyBtn) {
      const originalLabel = copyBtn.textContent || '';
      let copyResetTimer: ReturnType<typeof setTimeout> | null = null;

      copyBtn.addEventListener('click', async () => {
        const targetEmail = copyBtn.dataset.email || emailDestino;
        try {
          await navigator.clipboard.writeText(targetEmail);
          copyBtn.textContent = '¡Correo copiado!';
          if (copyResetTimer) clearTimeout(copyResetTimer);
          copyResetTimer = setTimeout(() => {
            copyBtn.textContent = originalLabel;
          }, 2200);
        } catch {
          window.prompt('Copia el correo:', targetEmail);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
</script>
