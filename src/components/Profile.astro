---
import ProfileCard from './ProfileCard.astro';
---

<ProfileCard ctaLabel="Cotizar mi proyecto" ctaTarget="contact" headingTag="div" />

<section class="card-section">
  <h2 class="section-label">¿Por qué trabajar conmigo?</h2>

  <div class="pitch-callout">
    <strong>Trato directo de principio a fin:</strong> Hablas por WhatsApp directamente con quien diseña y programa tu web. Sin intermediarios, sin reuniones interminables y con fecha de entrega clara desde el día uno.
  </div>

  <p class="hero-bio">
    Si ya te pasó esperar semanas por una web lenta o igual a las demás, aquí trabajamos distinto: código limpio hecho a medida para que tu página abra al instante en cualquier celular y convierta visitas en mensajes.
  </p>

  <div class="pitch-highlights" id="pitch-cards-stack">
    <div class="pitch-item">
      <div class="pitch-item-title">
        <span>Carga en segundos</span>
      </div>
      <p class="pitch-item-desc">
        Construyo con Astro para que tu web abra casi al instante en datos móviles y no pierdas clientes por lentitud.
      </p>
    </div>

    <div class="pitch-item">
      <div class="pitch-item-title">
        <span>Trato 1 a 1 por WhatsApp</span>
      </div>
      <p class="pitch-item-desc">
        Coordinas avances y cambios directo conmigo, sin intermediarios ni respuestas genéricas de soporte.
      </p>
    </div>

    <div class="pitch-item">
      <div class="pitch-item-title">
        <span>Entrega en días</span>
      </div>
      <p class="pitch-item-desc">
        Landing pages listas en 3 a 5 días hábiles tras recibir tu material, con 30 días de garantía técnica incluida.
      </p>
    </div>

    <div class="pitch-item">
      <div class="pitch-item-title">
        <span>Soporte sin ataduras</span>
      </div>
      <p class="pitch-item-desc">
        Planes de mantenimiento a medida para mantener tu web activa y actualizada cuando me escribas, sin contratos forzosos.
      </p>
    </div>
  </div>
</section>

<script>
  function setupPitchCardsStack() {
    const stack = document.getElementById('pitch-cards-stack');
    if (!stack || stack.dataset.initialized === 'true') return;
    stack.dataset.initialized = 'true';

    const cards = Array.from(stack.querySelectorAll<HTMLElement>('.pitch-item'));
    if (cards.length === 0) return;

    let currentIndex = 0;
    let intervalId: ReturnType<typeof setInterval> | null = null;
    let transitionTimeoutId: ReturnType<typeof setTimeout> | null = null;
    let isTransitioning = false;
    let lastTouchHandledAt = 0;

    function isMobile() {
      return window.innerWidth <= 640;
    }

    function syncStackHeight() {
      if (!stack) return;
      if (!isMobile()) {
        stack.style.height = '';
        return;
      }
      const maxCardHeight = cards.reduce((max, card) => Math.max(max, card.offsetHeight), 120);
      stack.style.height = `${maxCardHeight + 24}px`;
    }

    function renderStack(leavingCard: HTMLElement | null = null, direction: 'left' | 'right' = 'left') {
      if (!isMobile()) {
        cards.forEach((card) => {
          card.style.transform = '';
          card.style.opacity = '';
          card.style.zIndex = '';
          card.style.pointerEvents = '';
          card.style.filter = '';
        });
        syncStackHeight();
        return;
      }

      cards.forEach((card, i) => {
        if (card === leavingCard) {
          const x = direction === 'left' ? '-115%' : '115%';
          const rot = direction === 'left' ? '-7deg' : '7deg';
          card.style.transform = `translateX(${x}) rotate(${rot}) scale(0.92)`;
          card.style.opacity = '0';
          card.style.zIndex = '20';
          card.style.pointerEvents = 'none';
          return;
        }

        const offset = (i - currentIndex + cards.length) % cards.length;

        if (offset === 0) {
          card.style.transform = 'translateY(0px) scale(1)';
          card.style.opacity = '1';
          card.style.zIndex = '10';
          card.style.pointerEvents = 'auto';
          card.style.filter = 'none';
        } else if (offset === 1) {
          card.style.transform = 'translateY(10px) scale(0.96)';
          card.style.opacity = '0.72';
          card.style.zIndex = '9';
          card.style.pointerEvents = 'none';
          card.style.filter = 'none';
        } else if (offset === 2) {
          card.style.transform = 'translateY(20px) scale(0.92)';
          card.style.opacity = '0.42';
          card.style.zIndex = '8';
          card.style.pointerEvents = 'none';
          card.style.filter = 'none';
        } else {
          card.style.transform = 'translateY(28px) scale(0.88)';
          card.style.opacity = '0';
          card.style.zIndex = '7';
          card.style.pointerEvents = 'none';
          card.style.filter = 'none';
        }
      });

      syncStackHeight();
    }

    function advance(step: 1 | -1, direction: 'left' | 'right', manual = false) {
      if (!isMobile() || isTransitioning) return;
      isTransitioning = true;

      const leaving = cards[currentIndex];
      currentIndex = (currentIndex + step + cards.length) % cards.length;
      renderStack(leaving, direction);

      if (transitionTimeoutId) clearTimeout(transitionTimeoutId);
      transitionTimeoutId = setTimeout(() => {
        isTransitioning = false;
        renderStack();
      }, 450);

      if (manual) restartTimer();
    }

    function startTimer() {
      stopTimer();
      if (isMobile()) {
        intervalId = setInterval(() => {
          advance(1, 'left', false);
        }, 7000);
      }
    }

    function stopTimer() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }

    function restartTimer() {
      stopTimer();
      startTimer();
    }

    let startX = 0;
    let startY = 0;
    let endX = 0;
    let endY = 0;

    stack.addEventListener('touchstart', (e) => {
      if (!isMobile()) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      endX = startX;
      endY = startY;
    }, { passive: true });

    stack.addEventListener('touchmove', (e) => {
      if (!isMobile()) return;
      endX = e.touches[0].clientX;
      endY = e.touches[0].clientY;
    }, { passive: true });

    stack.addEventListener('touchend', () => {
      if (!isMobile()) return;
      const diffX = endX - startX;
      const diffY = endY - startY;

      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        lastTouchHandledAt = Date.now();
        if (diffX < 0) {
          advance(1, 'left', true);
        } else {
          advance(-1, 'right', true);
        }
      } else if (Math.abs(diffX) < 10 && Math.abs(diffY) < 10) {
        lastTouchHandledAt = Date.now();
        advance(1, 'left', true);
      }
    });

    stack.addEventListener('click', () => {
      if (!isMobile()) return;
      // Evita doble disparo cuando touchend ya manejó el toque y el navegador sintetiza click
      if (Date.now() - lastTouchHandledAt < 400) return;
      advance(1, 'left', true);
    });

    renderStack();
    startTimer();

    window.addEventListener('resize', () => {
      renderStack();
      if (isMobile()) {
        if (!intervalId) startTimer();
      } else {
        stopTimer();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPitchCardsStack);
  } else {
    setupPitchCardsStack();
  }
</script>
