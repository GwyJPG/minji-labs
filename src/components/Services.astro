---
// Services.astro - Servicios Minji Labs (Sin rebote, fluido a 60fps)
const services = [
  {
    id: "landing-1",
    title: "One-page website",
    desc: "Sitio web de una sola página enfocado en conversión directa. Estructura optimizada para presentar tu propuesta de valor, beneficios clave y llamada a la acción directa a tu WhatsApp.",
    features: [],
    isOpen: true
  },
  {
    id: "landing-multi",
    title: "Multi-page website",
    desc: "Sitio web multi-sección o con páginas internas, navegación fluida y animaciones personalizadas para una experiencia visual atractiva y memorable que destaque.",
    features: [],
    isOpen: false
  },
  {
    id: "soporte",
    title: "Soporte de página",
    desc: "Mantenimiento continuo para que no te preocupes por caídas ni errores. Incluye monitoreo, copias de seguridad periódicas, pequeñas actualizaciones de texto o fotos y soporte directo por WhatsApp.",
    features: [],
    isOpen: false
  },
  {
    id: "apps",
    title: "Aplicación Web",
    desc: "Por el momento me encuentro desarrollando distintas aplicaciones, si quieres saber más puedes mandarme un mensaje y saber si tengo una aplicación web para tu negocio.",
    features: [],
    isOpen: false
  }
];
---

<section class="card-section selv-services-card">
  <h2 class="selv-section-label">Servicios</h2>

  <div class="services-list-group">
    {services.map((s) => (
      <div 
        class={`service-item-row ${s.isOpen ? 'is-open' : ''}`}
        data-service-id={s.id}
      >
        <button class="service-row-btn" type="button" aria-expanded={s.isOpen ? 'true' : 'false'}>
          <span class="service-row-title">{s.title}</span>
          <span class="service-row-symbol">{s.isOpen ? '—' : '+'}</span>
        </button>

        <div class="service-accordion-drawer">
          <div class="service-drawer-inner">
            <p class="service-drawer-text">{s.desc}</p>
            {s.features.length > 0 && (
              <div class="service-drawer-tags">
                {s.features.map((f) => (
                  <span class="service-drawer-tag">✓ {f}</span>
                ))}
              </div>
            )}
            <div class="service-drawer-cta">
              <a 
                href={`https://wa.me/51999999999?text=Hola%20Minji%2C%20quisiera%20consultar%20sobre%20${encodeURIComponent(s.title)}`} 
                target="_blank" 
                rel="noopener" 
                class="service-whatsapp-link"
              >
                <span>Consultar por WhatsApp</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .selv-services-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }

  @media (min-width: 640px) {
    .selv-services-card {
      padding: 32px;
      gap: 20px;
    }
  }

  /* Lista de servicios */
  .services-list-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  /* Fila individual: ancho 100% constante para eliminar cualquier reflow horizontal */
  .service-item-row {
    width: 100%;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    overflow: hidden;
  }

  .service-item-row:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .service-item-row.is-open {
    background: rgba(24, 24, 30, 0.85);
    border-color: var(--c-primary-border);
    box-shadow: 0 10px 24px -6px rgba(0, 0, 0, 0.5);
  }

  /* Cabecera del acordeón */
  .service-row-btn {
    width: 100%;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: transparent;
    border: none;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
  }

  .service-row-title {
    color: var(--c-text-primary);
    line-height: 1.3;
  }

  .service-row-symbol {
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1;
    color: rgba(255, 255, 255, 0.65);
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .service-item-row.is-open .service-row-symbol {
    color: var(--c-primary);
    font-weight: 400;
  }

  /* Expansión ultra-fluida mediante CSS Grid (Zero rebote ni saltos) */
  .service-accordion-drawer {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-item-row.is-open .service-accordion-drawer {
    grid-template-rows: 1fr;
  }

  .service-drawer-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 200ms ease, transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-item-row.is-open .service-drawer-inner {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 240ms ease 40ms, transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-drawer-text {
    padding: 0 20px 14px;
    font-size: 0.9rem;
    color: var(--c-text-secondary);
    line-height: 1.6;
  }

  .service-drawer-tags {
    padding: 0 20px 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .service-drawer-tag {
    font-size: 0.76rem;
    color: var(--c-text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .service-drawer-cta {
    padding: 0 20px 18px;
  }

  .service-whatsapp-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-primary);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .service-whatsapp-link:hover {
    color: #ffffff;
    gap: 12px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rows = document.querySelectorAll<HTMLElement>('.service-item-row');

    rows.forEach((item) => {
      const btn = item.querySelector<HTMLElement>('.service-row-btn');
      const symbol = item.querySelector<HTMLElement>('.service-row-symbol');
      if (!btn || !symbol) return;

      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Cerrar los demás suavemente
        rows.forEach((other) => {
          if (other !== item) {
            other.classList.remove('is-open');
            const otherBtn = other.querySelector<HTMLElement>('.service-row-btn');
            const otherSymbol = other.querySelector<HTMLElement>('.service-row-symbol');
            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            if (otherSymbol) otherSymbol.textContent = '+';
          }
        });

        if (isOpen) {
          item.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          symbol.textContent = '+';
        } else {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          symbol.textContent = '—';
        }
      });
    });
  });
</script>
