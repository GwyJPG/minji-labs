---
import Accordion, { type AccordionEntry } from './Accordion.astro';
import { SERVICES, getWhatsAppUrl } from '../data/site';

const serviceItems: AccordionEntry[] = SERVICES.map((s) => ({
  id: s.id,
  title: s.title,
  desc: s.desc,
  features: s.features,
  isOpen: s.isOpen,
  ctaHref: getWhatsAppUrl(`Hola Minji, quisiera consultar sobre ${s.title}`),
  ctaLabel: 'Cotizar por WhatsApp',
}));
---

<section class="card-section services-card">
  <h2 class="section-label">Servicios</h2>
  <Accordion items={serviceItems} groupId="services" />
</section>

<style>
  .services-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }

  @media (min-width: 640px) {
    .services-card {
      padding: 32px;
      gap: 20px;
    }
  }
</style>
