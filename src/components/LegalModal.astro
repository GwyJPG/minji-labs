---
// LegalModal.astro - Documentos Legales en Regla (Minji Labs)
// Términos del Servicio, Política de Privacidad (Ley N° 29733 Perú) y Acuerdo de Soporte
---

<div id="legal-modal-backdrop" class="legal-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="legal-modal-title">
  <div class="legal-modal-card">
    <!-- Encabezado del Modal -->
    <div class="legal-modal-header">
      <div id="legal-modal-title" class="legal-modal-title">Documentos Legales · Minji Labs</div>
      <button type="button" id="legal-modal-close" class="legal-modal-close-btn" aria-label="Cerrar ventana modal">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Pestañas de Navegación Legal -->
    <div class="legal-modal-tabs" role="tablist">
      <button type="button" class="legal-tab-btn is-active" data-legal-tab="terms" role="tab" aria-selected="true">
        Términos del Servicio
      </button>
      <button type="button" class="legal-tab-btn" data-legal-tab="privacy" role="tab" aria-selected="false">
        Política de Privacidad
      </button>
      <button type="button" class="legal-tab-btn" data-legal-tab="support" role="tab" aria-selected="false">
        Acuerdo de Soporte (S/. 49)
      </button>
    </div>

    <!-- Contenido Scrollable de los Documentos -->
    <div class="legal-modal-content">
      <!-- 1. TÉRMINOS DEL SERVICIO -->
      <div id="doc-panel-terms" class="legal-doc-panel is-active" role="tabpanel">
        <div>
          <h3 class="legal-clause-title">1. Identificación y Alcance</h3>
          <p class="legal-clause-text">
            Minji Labs es un servicio independiente de diseño y desarrollo web radicado en Lima, Perú. Las presentes condiciones regulan la contratación y prestación de servicios digitales de desarrollo de páginas web, landing pages de alta velocidad, aplicaciones web y servicios de soporte técnico.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">2. Proceso de Cotización y Contratación</h3>
          <p class="legal-clause-text">
            Toda cotización se realiza de manera directa y personalizada según los requerimientos solicitados por el cliente a través de WhatsApp o correo electrónico. El inicio oficial del desarrollo y el cómputo de plazos de entrega comienzan una vez acreditado el anticipo del 50% pactado.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">3. Tiempos de Entrega y Recepción de Insumos</h3>
          <p class="legal-clause-text">
            Los plazos estimados son: de 3 a 5 días laborables para Landing Pages de 1 hoja, y de 7 a 12 días laborables para proyectos multi-sección con animaciones personalizadas. Los plazos están condicionados a que el cliente entregue oportunamente los insumos necesarios (logotipo, textos base e imágenes del negocio).
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">4. Esquema de Pagos y Liquidación</h3>
          <p class="legal-clause-text">
            Se requiere un anticipo del 50% al iniciar y el 50% restante contra entrega final, previa revisión y conformidad del cliente en el entorno de pruebas o servidor de despliegue antes de la entrega definitiva de accesos y archivos.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">5. Propiedad Intelectual</h3>
          <p class="legal-clause-text">
            Al cancelarse el 100% del monto acordado, la totalidad del código, diseño y contenidos pasan a ser propiedad exclusiva del cliente. Minji Labs se reserva el derecho de exhibir el proyecto como referencia en su portafolio profesional, salvo solicitud expresa de acuerdo de confidencialidad (NDA).
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">6. Garantía de Funcionamiento</h3>
          <p class="legal-clause-text">
            Se otorgan 30 días calendario de garantía técnica tras la entrega para resolver cualquier falla de programación o error de visualización atribuible al desarrollo original, sin costo adicional.
          </p>
        </div>
      </div>

      <!-- 2. POLÍTICA DE PRIVACIDAD -->
      <div id="doc-panel-privacy" class="legal-doc-panel" role="tabpanel">
        <div>
          <h3 class="legal-clause-title">1. Marco Normativo (Ley N° 29733 - Perú)</h3>
          <p class="legal-clause-text">
            En cumplimiento de la Ley N° 29733 de Protección de Datos Personales de la República del Perú y su Reglamento (D.S. 003-2013-JUS), Minji Labs garantiza el tratamiento confidencial y seguro de la información facilitada por los usuarios.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">2. Datos Recopilados</h3>
          <p class="legal-clause-text">
            Únicamente se recopilan datos de contacto suministrados de forma voluntaria por el cliente (nombre, número de WhatsApp, correo electrónico e información comercial del negocio) con el fin exclusivo de emitir cotizaciones, ejecutar el proyecto contratado y brindar soporte.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">3. Confidencialidad y No Transferencia</h3>
          <p class="legal-clause-text">
            Minji Labs no vende, arrienda, comercializa ni cede información personal ni comercial a terceros. No se emplean cookies de rastreo invasivas ni herramientas de telemetría de terceros en este sitio web.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">4. Derechos ARCO</h3>
          <p class="legal-clause-text">
            El titular puede solicitar en cualquier momento el acceso, rectificación, cancelación u oposición al tratamiento de sus datos personales mediante comunicación directa al canal oficial de WhatsApp o por correo electrónico.
          </p>
        </div>
      </div>

      <!-- 3. ACUERDO DE SOPORTE MENSUAL -->
      <div id="doc-panel-support" class="legal-doc-panel" role="tabpanel">
        <div>
          <h3 class="legal-clause-title">1. Cobertura del Plan de Soporte (S/. 49 / mes)</h3>
          <p class="legal-clause-text">
            Servicio continuo orientado a mantener el sitio web seguro, activo y actualizado. Incluye monitoreo continuo de disponibilidad (uptime), copias de seguridad mensuales (backups de seguridad) y hasta dos intervenciones al mes para cambios menores de texto, actualización de precios o reemplazo de fotos suministradas por el cliente.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">2. Exclusiones del Plan</h3>
          <p class="legal-clause-text">
            No comprende el rediseño total de la página, la creación de nuevas secciones complejas, el desarrollo de pasarelas de pago no contempladas originalmente ni funciones de backend complejas. Dichos requerimientos se cotizarán por separado como ampliaciones de proyecto.
          </p>
        </div>

        <div>
          <h3 class="legal-clause-title">3. Sin Permanencia Forzosa</h3>
          <p class="legal-clause-text">
            El servicio se paga mensualmente por adelantado. El cliente puede dar de baja o pausar el servicio en cualquier momento sin penalidades ni contratos forzosos, bastando con notificarlo por WhatsApp con 5 días calendario de anticipación al siguiente corte mensual.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const backdrop = document.getElementById('legal-modal-backdrop');
    const closeBtn = document.getElementById('legal-modal-close');
    const tabButtons = document.querySelectorAll<HTMLElement>('.legal-tab-btn');
    const docPanels = document.querySelectorAll<HTMLElement>('.legal-doc-panel');
    const triggerButtons = document.querySelectorAll<HTMLElement>('[data-legal-trigger]');

    function openModal(tabKey: string = 'terms') {
      if (!backdrop) return;
      backdrop.classList.add('is-open');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      selectTab(tabKey);
    }

    function closeModal() {
      if (!backdrop) return;
      backdrop.classList.remove('is-open');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function selectTab(tabKey: string) {
      tabButtons.forEach(btn => {
        const isMatch = btn.dataset.legalTab === tabKey;
        btn.classList.toggle('is-active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      docPanels.forEach(panel => {
        const isMatch = panel.id === `doc-panel-${tabKey}`;
        panel.classList.toggle('is-active', isMatch);
      });
    }

    triggerButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tabKey = btn.dataset.legalTrigger || 'terms';
        openModal(tabKey);
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop?.classList.contains('is-open')) {
        closeModal();
      }
    });

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabKey = btn.dataset.legalTab;
        if (tabKey) selectTab(tabKey);
      });
    });
  });
</script>
