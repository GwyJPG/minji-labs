---
import { getImage } from 'astro:assets';
import bgDesktop from '../assets/images/bg-desktop.jpg';
import bgMobile from '../assets/images/bg-mobile.jpg';
import '../styles/tokens.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import LegalModal from '../components/LegalModal.astro';
import { SITE_CONFIG } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
} = Astro.props;

const bgDesktopAvif = await getImage({ src: bgDesktop, format: 'avif', quality: 65 });
const bgDesktopWebp = await getImage({ src: bgDesktop, format: 'webp', quality: 80 });
const bgDesktopFallback = await getImage({ src: bgDesktop, format: 'jpg', quality: 80 });
const bgMobileAvif = await getImage({ src: bgMobile, format: 'avif', quality: 65 });
const bgMobileWebp = await getImage({ src: bgMobile, format: 'webp', quality: 80 });
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#09090b" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/images/avatar-minji.jpg" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="fixed-bg-wrapper" aria-hidden="true">
    <picture>
      <source media="(max-width: 768px)" srcset={bgMobileAvif.src} type="image/avif" />
      <source media="(max-width: 768px)" srcset={bgMobileWebp.src} type="image/webp" />
      <source srcset={bgDesktopAvif.src} type="image/avif" />
      <source srcset={bgDesktopWebp.src} type="image/webp" />
      <img
        src={bgDesktopFallback.src}
        alt=""
        class="fixed-bg-image"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="fixed-bg-vignette"></div>
  </div>

  <div class="noise-overlay" aria-hidden="true"></div>

  <main class="main-wrapper">
    <slot />
    <Footer />
  </main>

  <nav class="floating-dock-container" aria-label="Navegación principal">
    <div class="floating-dock">
      <div class="dock-active-pill" aria-hidden="true"></div>

      <button type="button" class="dock-item is-active" data-view="home" data-tooltip="Inicio" aria-label="Inicio">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </button>

      <button type="button" class="dock-item" data-view="profile" data-tooltip="Sobre Mí" aria-label="Sobre Mí">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </button>

      <button type="button" class="dock-item" data-view="contact" data-tooltip="Contacto" aria-label="Contacto">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </button>
    </div>
  </nav>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const dockItems = document.querySelectorAll<HTMLElement>('.dock-item');
      const activePill = document.querySelector<HTMLElement>('.dock-active-pill');
      const viewPanels = document.querySelectorAll<HTMLElement>('.view-panel');

      function updateActivePill(activeBtn: HTMLElement) {
        if (!activeBtn || !activePill) return;
        activePill.style.transform = `translateX(${activeBtn.offsetLeft}px)`;
      }

      function switchView(targetViewId: string, scroll = true) {
        let resolvedId = targetViewId;
        let found = false;

        viewPanels.forEach((panel) => {
          const isMatch = panel.id === `view-${targetViewId}`;
          panel.classList.toggle('is-active', isMatch);
          if (isMatch) found = true;
        });

        if (!found) {
          document.getElementById('view-home')?.classList.add('is-active');
          resolvedId = 'home';
        }

        dockItems.forEach((btn) => {
          const isMatch = btn.dataset.view === resolvedId;
          btn.classList.toggle('is-active', isMatch);
          if (isMatch) updateActivePill(btn);
        });

        if (scroll) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        history.replaceState(null, '', `#${resolvedId}`);
      }

      dockItems.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const viewId = btn.dataset.view;
          if (viewId) switchView(viewId);
        });
      });

      document.querySelectorAll<HTMLElement>('[data-navigate]').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const viewId = link.getAttribute('data-navigate');
          if (viewId) switchView(viewId);
        });
      });

      const initialHash = window.location.hash.replace('#', '') || 'home';
      const initialBtn = document.querySelector<HTMLElement>(`.dock-item[data-view="${initialHash}"]`) || dockItems[0];
      if (initialBtn?.dataset.view) {
        switchView(initialBtn.dataset.view, false);
        requestAnimationFrame(() => updateActivePill(initialBtn));
      }

      window.addEventListener('resize', () => {
        const activeBtn = document.querySelector<HTMLElement>('.dock-item.is-active');
        if (activeBtn) updateActivePill(activeBtn);
      });
    });
  </script>

  <LegalModal />
</body>
</html>
